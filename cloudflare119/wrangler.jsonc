{
  "name": "gimpo-course-db",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "course-secundus",
      "database_id": "ee9ece7b-d324-4324-96cb-04ce16118da6"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      },
      {
        "name": "MEDIA",
        "class_name": "Attachment120"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RealtimeHub"
      ]
    },
    {
      "tag": "v120",
      "new_sqlite_classes": [
        "Attachment120"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
